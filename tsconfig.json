{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@torna/shared/*": ["shared/*"] }
  },
  "include": ["shared/**/*", "scripts/**/*", "packages/**/*"],
  "exclude": ["node_modules", "**/dist", "**/out", "**/lib", "**/cache"]
}
