# Torna — 환경 변수 예시
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 마세요.

# ── 공통 ────────────────────────────────────────────────
# Monad Testnet RPC. 공용 엔드포인트는 50 rps 제한이 있어
# 800건 일괄 실행에는 QuickNode 엔드포인트가 필요합니다.
MONAD_RPC_URL= 
MONAD_CHAIN_ID=10143

# ── B · 컨트랙트 ────────────────────────────────────────
# 테스트 전용 니모닉. index 0~12에서 지갑 13개를 파생합니다.
# 실제 자산이 있는 지갑을 절대 쓰지 마세요.
DEPLOYER_MNEMONIC=
# 배포 후 채웁니다.
TORNA_CONTRACT_ADDRESS=

# ── C · 어댑터와 원장 DB ────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── 실행 ────────────────────────────────────────────────
# 한 회차의 실행 식별자. 스냅샷 12개가 모두 같은 값을 가져야 합니다.
RUN_ID=run-20260925
