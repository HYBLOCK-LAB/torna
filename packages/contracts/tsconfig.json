{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["script/**/*.ts", "test-ts/**/*.ts", "../../shared/abi/**/*.ts", "../../shared/types/snapshot.ts"]
}
