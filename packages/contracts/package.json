{
  "name": "@torna/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:solidity": "node script/install-dependencies.mjs",
    "build": "forge build --root .",
    "export:abi": "forge build --root . && node script/export-abi.mjs",
    "scenario:plan": "node --import tsx script/run-scenarios.ts --plan",
    "scenario:t0": "forge build --root . && node --import tsx script/run-scenarios.ts --t0",
    "check": "forge fmt --check --root . && forge build --root . && node script/export-abi.mjs --check && tsc --project tsconfig.json && forge test --root . && node --import tsx --test test-ts/*.test.ts",
    "test": "forge test --root . && node --import tsx --test test-ts/*.test.ts",
    "test:shared": "forge build --root . && node --import tsx --test test-ts/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "fmt:check": "forge fmt --check --root ."
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "viem": "2.37.13"
  }
}
